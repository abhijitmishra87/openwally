# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required if any role uses a Claude model (the default for all roles)
ANTHROPIC_API_KEY=sk-ant-...

# ── Ollama ────────────────────────────────────────────────────────────────────
# Required only if any role is set to an ollama/* model below
# Ollama must be running locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# ── Per-role model assignments ────────────────────────────────────────────────
# Each role can independently use a Claude model or a local Ollama model.
# Claude models: use the bare model name — the provider prefix is added automatically.
# Ollama models: prefix with "ollama/" — e.g. ollama/llama3.2, ollama/mistral
#
# Defaults (all Claude — highest quality):
# PM_MODEL=claude-opus-4-7
# ARCHITECT_MODEL=claude-opus-4-7
# SECURITY_MODEL=claude-opus-4-7
# EM_MODEL=claude-sonnet-4-6
# UI_DESIGNER_MODEL=claude-opus-4-7
# UI_DEV_MODEL=claude-opus-4-7
# DEV_MODEL=claude-sonnet-4-6
# QA_MODEL=claude-sonnet-4-6
# UAT_MODEL=claude-haiku-4-5-20251001
#
# Cost-saving hybrid (Ollama for lighter roles):
# QA_MODEL=ollama/llama3.2
# UAT_MODEL=ollama/mistral
#
# Fully local (no API key needed — lower output quality):
# PM_MODEL=ollama/llama3.2
# ARCHITECT_MODEL=ollama/llama3.2
# SECURITY_MODEL=ollama/mistral
# EM_MODEL=ollama/llama3.2
# UI_DESIGNER_MODEL=ollama/llama3.2
# UI_DEV_MODEL=ollama/llama3.2
# DEV_MODEL=ollama/mistral
# QA_MODEL=ollama/llama3.2
# UAT_MODEL=ollama/llama3.2

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./projects
